RoxygenNote: 7.3.3
Depends:
    R (>= 4.1)
Imports:
    curl (>= 6.0.0),
    jsonlite,
    sodium,
    tibble
Suggests:
    knhanes,
    testthat (>= 3.0.0),
    withr
